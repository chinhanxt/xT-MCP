        "read"
      ],
      "scope": "all"
    },
    "ke_toan_truong": {
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    "giam_doc": {
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    "xt_workflow": {
