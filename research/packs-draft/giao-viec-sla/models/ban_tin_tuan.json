{
  "id": "gv_bt",
  "name": "ban_tin_tuan",
  "label": "Bản tin tuần",
  "title_field": "ma",
  "fields": [
    {
      "id": "f1",
      "name": "ma",
      "type": "text",
      "label": "Mã bản tin",
      "required": true,
      "unique": true,
      "regex": "^BT-[0-9]{4}-W[0-9]{2}(-[A-Z]{2,6})?$"
    },
    {
      "id": "f2",
      "name": "tu_ngay",
      "type": "date",
      "label": "Từ ngày",
      "required": true
    },
    {
      "id": "f3",
      "name": "den_ngay",
      "type": "date",
      "label": "Đến ngày",
      "required": true
    },
    {
      "id": "f4",
      "name": "phong_ban",
      "type": "text",
      "label": "Phòng ban (rỗng = toàn công ty)",
      "max": 20
    },
    {
      "id": "f5",
      "name": "tong_giao_moi",
      "type": "number",
      "label": "Số việc giao mới",
      "required": true,
      "min": 0,
      "default": 0
    },
    {
      "id": "f6",
      "name": "tong_hoan_thanh",
      "type": "number",
      "label": "Số việc hoàn thành",
      "required": true,
      "min": 0,
      "default": 0
    },
    {
      "id": "f7",
      "name": "tong_qua_han",
      "type": "number",
      "label": "Số việc quá hạn",
      "required": true,
      "min": 0,
      "default": 0
    },
    {
      "id": "f8",
      "name": "tong_dang_ket",
      "type": "number",
      "label": "Số việc đang bị chặn",
      "required": true,
      "min": 0,
      "default": 0
    },
    {
      "id": "f9",
      "name": "noi_dung",
      "type": "text",
      "label": "Nội dung bản tin",
      "max": 8000
    },
    {
      "id": "f10",
      "name": "chi_tiet",
      "type": "json",
      "label": "Chi tiết (kèm id bản ghi gốc)"
    },
    {
      "id": "f11",
      "name": "da_gui",
      "type": "bool",
      "label": "Đã gửi",
      "required": true,
      "default": false
    }
  ],
  "indexes": [
    {
      "id": "i1",
      "fields": [
        "tu_ngay"
      ]
    }
  ],
  "rules": [
    {
      "id": "r1",
      "message": "'Đến ngày' phải sau hoặc bằng 'Từ ngày'",
      "check": {
        "field": "den_ngay",
        "op": ">=",
        "other_field": "tu_ngay"
      }
    }
  ],
  "permissions": {
    "truong_bo_phan": {
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    "giam_doc": {
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    "nhan_vien": {
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    "xt_workflow": {
      "actions": [
        "create",
        "read",
        "update"
      ],
      "scope": "all"
    }
  }
}
