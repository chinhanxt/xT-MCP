{
  "id": "weekly_digest",
  "name": "Bản tin công việc hằng tuần",
  "version": 3,
  "inputs": {
    "from_date": {
      "type": "date"
    },
    "to_date": {
      "type": "date"
    },
    "department": {
      "type": "str"
    }
  },
  "trigger": {
    "kind": "timer",
    "rrule": "FREQ=WEEKLY;BYDAY=MO;BYHOUR=8;BYMINUTE=0",
    "tz": "Asia/Ho_Chi_Minh",
    "input": {
      "from_date": "period_start_date",
      "to_date": "period_end_date",
      "department": "''"
    },
    "catchup": "latest"
  },
  "steps": [
    {
      "id": "rollup",
      "type": "service",
      "name": "Tổng hợp công việc tuần",
      "op": "weekly_rollup",
      "params": {
        "from_date": "from_date",
        "to_date": "to_date",
        "department": "department"
      }
    },
    {
      "id": "send",
      "type": "service",
      "name": "Gửi bản tin cho trưởng bộ phận và giám đốc",
      "op": "send_weekly_digest",
      "params": {
        "digest_id": "rollup_result['digest_id']",
        "to_roles": "'director,dept_head'"
      }
    }
  ]
}
