{
  "id": "employee_onboarding",
  "name": "Tiếp nhận nhân sự mới (HR, IT, Kế toán, Quản lý)",
  "version": 6,
  "roles": [
    "hr",
    "it_admin",
    "payment_accountant",
    "chief_accountant",
    "director"
  ],
  "inputs": {
    "case_id": {
      "type": "str"
    },
    "employee_id": {
      "type": "str"
    },
    "employee_user": {
      "type": "user"
    }
  },
  "fallback_assignee": "role(director)",
  "steps": [
    {
      "id": "init",
      "type": "service",
      "name": "Sinh checklist liên phòng ban",
      "op": "create_lifecycle_tasks",
      "params": {
        "case_id": "case_id",
        "kind": "'onboarding'"
      }
    },
    {
      "id": "hr",
      "type": "task",
      "name": "Nhân sự: hồ sơ, HĐLĐ, BHXH",
      "assignee": "role(hr)",
      "sla": {
        "after": "PT24H",
        "escalate_to": "department_head('NS')"
      },
      "complete_via": {
        "model": "lifecycle_task",
        "match": {
          "lifecycle_case": "case_id",
          "step": "'hr'"
        },
        "states": {
          "done": "done",
          "skipped": "done"
        },
        "autonomy": "human_only",
        "writable_fields": [
          "note"
        ]
      }
    },
    {
      "id": "parallel_setup",
      "type": "parallel",
      "name": "IT, Kế toán, Quản lý làm song song",
      "branches": [
        [
          {
            "id": "it",
            "type": "task",
            "name": "IT: email, tài khoản, thiết bị",
            "assignee": "role(it_admin)",
            "outcomes": [
              "done",
              "request_info"
            ],
            "sla": {
              "after": "PT24H",
              "escalate_to": "department_head('IT')"
            },
            "complete_via": {
              "model": "lifecycle_task",
              "match": {
                "lifecycle_case": "case_id",
                "step": "'it'"
              },
              "states": {
                "done": "done",
                "skipped": "done"
              },
              "autonomy": "human_only",
              "writable_fields": [
                "note"
              ]
            }
          },
          {
            "id": "it_grants",
            "type": "service",
            "name": "Áp quyền SSO xT đã cấp (access_grant keycloak)",
            "op": "sync_access_grants",
            "params": {
              "case_id": "case_id",
              "allowed_roles": "'employee,hr,it_admin,payment_accountant,dept_head'"
            }
          }
        ],
        [
          {
            "id": "accounting",
            "type": "task",
            "name": "Kế toán: mã lương, tài khoản nhận lương",
            "assignee": "role(payment_accountant)",
            "sla": {
              "after": "PT24H",
              "escalate_to": "role(chief_accountant)"
            },
            "complete_via": {
              "model": "lifecycle_task",
              "match": {
                "lifecycle_case": "case_id",
                "step": "'accounting'"
              },
              "states": {
                "done": "done",
                "skipped": "done"
              },
              "autonomy": "human_only",
              "writable_fields": [
                "note"
              ]
            }
          }
        ],
        [
          {
            "id": "manager",
            "type": "task",
            "name": "Quản lý: buddy và kế hoạch 30-60-90",
            "assignee": "employee_user.manager",
            "sla": {
              "after": "PT48H",
              "escalate_to": "department_head(department(employee_user))"
            },
            "complete_via": {
              "model": "lifecycle_task",
              "match": {
                "lifecycle_case": "case_id",
                "step": "'manager'"
              },
              "states": {
                "done": "done",
                "skipped": "done"
              },
              "autonomy": "human_only",
              "writable_fields": [
                "note"
              ]
            }
          }
        ]
      ]
    },
    {
      "id": "activate",
      "type": "service",
      "name": "Kích hoạt nhân viên",
      "op": "activate_employee",
      "params": {
        "employee_id": "employee_id"
      }
    },
    {
      "id": "close_case",
      "type": "service",
      "name": "Đóng hồ sơ tiếp nhận",
      "op": "close_lifecycle_case",
      "params": {
        "case_id": "case_id"
      }
    }
  ]
}
