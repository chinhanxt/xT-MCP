{"jsonrpc":"2.0","method":"ui/notifications/sandbox-resource-ready","params":{"html":"<!DOCTYPE html>\n<!-- SPDX-License-Identifier: Apache-2.0 -->\n<html><head><meta charset=\"utf-8\"><title>xT record</title>\n<style>body{font:14px system-ui;margin:8px}table{border-collapse:collapse}td{padding:3px 8px;border-bottom:1px solid #eee}\n.tok{font-family:monospace;color:#555}.real{color:#0b7a3e;font-weight:600}button{margin-top:8px}</style></head>\n<body><table id=\"t\"></table><button id=\"reveal\" hidden>Xem giá trị thật (chỉ bạn thấy)</button><p id=\"s\"></p>\n<script>// SPDX-License-Identifier: Apache-2.0\n// Cầu nối MCP Apps tối thiểu (tự viết, không phụ thuộc): JSON-RPC 2.0 qua window.parent.postMessage.\n(function () {\n  let nextId = 1; const pending = new Map(); const handlers = {};\n  window.addEventListener(\"message\", (ev) => {\n    if (ev.source !== window.parent) return;\n    const m = ev.data; if (!m || m.jsonrpc !== \"2.0\") return;\n    if (m.method === undefined && pending.has(m.id)) {\n      const p = pending.get(m.id); pending.delete(m.id);\n      m.error ? p.rej(new Error(m.error.message)) : p.res(m.result); return;\n    }\n    if (m.method && handlers[m.method]) handlers[m.method](m.params);\n    if (m.method && m.id !== undefined) { // host request (vd ui/resource-teardown, ping): trả {}\n      window.parent.postMessage({ jsonrpc: \"2.0\", id: m.id, result: {} }, \"*\");\n    }\n  });\n  function request(method, params) {\n    const id = nextId++;\n    return new Promise((res, rej) => {\n      pending.set(id, { res, rej });\n      window.parent.postMessage({ jsonrpc: \"2.0\", id, method, params }, \"*\");\n    });\n  }\n  function notify(method, params) { window.parent.postMessage({ jsonrpc: \"2.0\", method, params }, \"*\"); }\n  window.xtBridge = {\n    on(method, fn) { handlers[method] = fn; },\n    async connect(name) {\n      const r = await request(\"ui/initialize\", { protocolVersion: \"2026-01-26\",\n        appInfo: { name, version: \"0.1.0\" }, appCapabilities: {} });\n      notify(\"ui/notifications/initialized\", {});\n      return r;\n    },\n    callTool(name, args) { return request(\"tools/call\", { name, arguments: args || {} }); },\n    sendSize() { notify(\"ui/notifications/size-changed\", { width: document.documentElement.scrollWidth, height: document.documentElement.scrollHeight }); },\n  };\n})();\n</script>\n<script>\n// Giá trị thật đi thẳng xT -> iframe (fetch), KHÔNG gửi lại host: không ui/message, không ui/update-model-context.\nconst XT = \"http://localhost:18210\", B = window.xtBridge, TOK = /^⟨[A-Za-z0-9][A-Za-z0-9_\\-]*\\.[a-z][a-z0-9_]*⟩$/;\nlet rec = null;\nfunction esc(s){return String(s).replace(/[&<>\"]/g,c=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]))}\nfunction render(values){ const t=document.getElementById(\"t\"); t.innerHTML=\"\";\n  for (const [k,v] of Object.entries(rec)) { if (k.startsWith(\"_\")||k===\"rev\") continue;\n    const isTok = typeof v===\"string\" && TOK.test(v), real = isTok && values && values[v];\n    const hint = rec._hint && rec._hint[k] ? \" (\"+esc(rec._hint[k])+\")\" : \"\";\n    t.insertAdjacentHTML(\"beforeend\", `<tr><td>${esc(k)}</td><td class=\"${real?'real':isTok?'tok':''}\">${esc(real?values[v]:v??\"\")}${real?\"\":hint}</td></tr>`); }\n  document.getElementById(\"reveal\").hidden = !Object.values(rec).some(v=>typeof v===\"string\"&&TOK.test(v)) || !!values;\n  B.sendSize(); }\nfunction b64u(buf){return btoa(String.fromCharCode(...new Uint8Array(buf))).replace(/\\+/g,\"-\").replace(/\\//g,\"_\").replace(/=+$/,\"\")}\ndocument.getElementById(\"reveal\").onclick = async () => {\n  const s=document.getElementById(\"s\"); s.textContent=\"Đang xin vé...\";\n  try {\n    const kp = await crypto.subtle.generateKey({name:\"ECDSA\",namedCurve:\"P-256\"}, false, [\"sign\"]);   // non-extractable\n    const jwk = await crypto.subtle.exportKey(\"jwk\", kp.publicKey);\n    const tokens = Object.values(rec).filter(v=>typeof v===\"string\"&&TOK.test(v));\n    const r = await B.callTool(\"pii_reveal_ticket\", {tokens, pubkey_jwk:{kty:jwk.kty,crv:jwk.crv,x:jwk.x,y:jwk.y}});\n    const m = (r._meta||{})[\"xt/reveal\"]; if (!m) throw new Error(\"không nhận được vé\");\n    const ts = Math.floor(Date.now()/1000);\n    const sig = await crypto.subtle.sign({name:\"ECDSA\",hash:\"SHA-256\"}, kp.privateKey, new TextEncoder().encode(m.ticket+\".\"+ts));\n    const resp = await fetch(m.url, {method:\"POST\", headers:{\"content-type\":\"application/json\"}, credentials:\"omit\",\n                                    body: JSON.stringify({ticket:m.ticket, ts, sig:b64u(sig)})});\n    const d = await resp.json(); if (!resp.ok) throw new Error(d.message||d.error);\n    s.textContent = d.denied.length ? `Không đủ quyền xem ${d.denied.length} trường` : \"\";\n    render(d.values);\n  } catch(e){ s.textContent = \"Lỗi: \"+e.message; } };\nB.on(\"ui/notifications/tool-result\", p => { const sc=p.structuredContent; if (sc&&sc.ok&&sc.result&&sc.result.record){ rec=sc.result.record; render(null);} });\nB.connect(\"xt-pii-card\");\n</script></body></html>\n","csp":{"connectDomains":["http://localhost:18210"]}}}
