{
  "version": "1",
  "tenant": "binhminh",
  "statements": [
    {
      "id": "hr.emp-own-read",
      "effect": "Allow",
      "subjects": [
        "role:employee"
      ],
      "actions": [
        "record.read"
      ],
      "resources": [
        "xrn:binhminh:employee:*",
        "xrn:binhminh:lifecycle_case:*",
        "xrn:binhminh:lifecycle_task:*",
        "xrn:binhminh:asset_issue:*",
        "xrn:binhminh:access_grant:*",
        "xrn:binhminh:offboarding_settlement:*",
        "xrn:binhminh:department:*",
        "xrn:binhminh:employee_pii:*"
      ],
      "conditions": [
        {
          "left": "resource.owner",
          "op": "eq",
          "right": {
            "ref": "subject.id"
          }
        }
      ]
    },
    {
      "id": "hr.hr-all",
      "effect": "Allow",
