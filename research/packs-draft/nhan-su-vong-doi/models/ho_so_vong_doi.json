{
  "id": "ns_hs",
  "name": "ho_so_vong_doi",
  "label": "Hồ sơ vòng đời nhân sự",
  "title_field": "ma",
  "fields": [
    {
      "id": "f1",
      "name": "ma",
      "type": "text",
      "label": "Mã hồ sơ",
      "required": true,
      "unique": true,
      "regex": "^(ON|OF)-[0-9]{4}-[0-9]{4}$"
    },
    {
      "id": "f2",
      "name": "nhan_vien",
      "type": "ref",
      "label": "Nhân viên",
      "required": true,
      "ref": "nhan_vien"
    },
    {
      "id": "f3",
      "name": "loai",
      "type": "enum",
      "label": "Loại",
      "required": true,
      "options": [
        {
          "value": "onboarding",
          "label": "Tiếp nhận nhân sự mới"
        },
        {
          "value": "offboarding",
          "label": "Nghỉ việc"
        }
      ]
    },
    {
      "id": "f4",
      "name": "ngay_hieu_luc",
      "type": "date",
      "label": "Ngày hiệu lực",
      "required": true
    },
    {
      "id": "f5",
      "name": "trang_thai",
      "type": "enum",
      "label": "Trạng thái",
      "required": true,
      "default": "dang_xu_ly",
      "options": [
        {
          "value": "dang_xu_ly",
          "label": "Đang xử lý"
        },
        {
          "value": "hoan_tat",
          "label": "Hoàn tất"
        },
        {
          "value": "huy",
          "label": "Hủy"
        }
      ]
    },
    {
      "id": "f6",
      "name": "buoc_hien_tai",
      "type": "text",
      "label": "Bước đang chờ",
      "max": 40
    },
    {
      "id": "f7",
      "name": "nguoi_khoi_tao",
      "type": "user",
      "label": "Người khởi tạo",
      "required": true
    },
    {
      "id": "f8",
      "name": "hoan_tat_luc",
      "type": "datetime",
      "label": "Thời điểm hoàn tất"
    },
    {
      "id": "f9",
      "name": "ma_tien_trinh",
      "type": "text",
      "label": "Mã tiến trình workflow",
      "max": 64
    }
  ],
  "indexes": [
    {
      "id": "i1",
      "fields": [
        "nhan_vien",
        "loai"
      ]
    }
  ],
  "rules": [
    {
      "id": "r1",
      "message": "Hồ sơ hoàn tất phải có thời điểm hoàn tất",
      "check": {
        "or": [
          {
            "field": "trang_thai",
            "op": "!=",
            "value": "hoan_tat"
          },
          {
            "field": "hoan_tat_luc",
            "op": "not_null"
          }
        ]
      }
    }
  ],
  "permissions": {
    "nhan_su": {
      "actions": [
        "create",
        "read",
        "update",
        "delete"
      ],
      "scope": "all"
    },
    "xt_workflow": {
      "actions": [
        "create",
        "read",
        "update"
      ],
      "scope": "all"
    },
    "giam_doc": {
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    "it_admin": {
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    "ke_toan_thanh_toan": {
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    "ke_toan_truong": {
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    "truong_bo_phan": {
      "actions": [
        "read"
      ],
      "scope": "department"
    },
    "nhan_vien": {
      "actions": [
        "read"
      ],
      "scope": "own"
    }
  }
}
