{
  "id": "dx_phieu",
  "name": "de_xuat",
  "label": "Đề xuất",
  "title_field": "ma_phieu",
  "fields": [
    {
      "id": "f1",
      "name": "ma_phieu",
      "type": "text",
      "label": "Mã phiếu",
      "required": true,
      "unique": true,
      "regex": "^(TU|TT|HU)-[0-9]{4}-[0-9]{4}$"
    },
    {
      "id": "f2",
      "name": "loai",
      "type": "ref",
      "label": "Loại đề xuất",
      "required": true,
      "ref": "loai_de_xuat"
    },
    {
      "id": "f3",
      "name": "nguoi_de_nghi",
      "type": "user",
      "label": "Người đề nghị",
      "required": true
    },
    {
      "id": "f4",
      "name": "phong_ban",
      "type": "text",
      "label": "Bộ phận/Phòng ban",
      "required": true,
      "max": 20
    },
    {
      "id": "f5",
      "name": "so_tien",
      "type": "money",
      "label": "Số tiền (VND)",
      "required": true,
      "min": 1,
      "max": 10000000000
    },
    {
      "id": "f6",
      "name": "so_tien_bang_chu",
      "type": "text",
      "label": "Số tiền bằng chữ",
      "max": 300
    },
    {
      "id": "f7",
      "name": "ly_do",
      "type": "text",
      "label": "Lý do",
      "required": true,
      "min": 5,
      "max": 1000
    },
    {
      "id": "f8",
      "name": "trang_thai",
      "type": "enum",
      "label": "Trạng thái",
      "required": true,
      "default": "nhap",
      "options": [
        {
          "value": "nhap",
          "label": "Nháp"
        },
        {
          "value": "cho_duyet",
          "label": "Chờ duyệt"
        },
        {
          "value": "da_duyet",
          "label": "Đã duyệt"
        },
        {
          "value": "tu_choi",
          "label": "Từ chối"
        },
        {
          "value": "da_chi",
          "label": "Đã chi/hoàn tất"
        },
        {
          "value": "huy",
          "label": "Hủy"
        }
      ]
    },
    {
      "id": "f9",
      "name": "buoc_hien_tai",
      "type": "text",
      "label": "Bước đang chờ",
      "max": 40
    },
    {
      "id": "f10",
      "name": "nguoi_duyet_cuoi",
      "type": "user",
      "label": "Người duyệt cuối"
    },
    {
      "id": "f11",
      "name": "ngay_duyet",
      "type": "datetime",
      "label": "Thời điểm duyệt cuối"
    },
    {
      "id": "f12",
      "name": "ma_tien_trinh",
      "type": "text",
      "label": "Mã tiến trình workflow",
      "max": 64
    }
  ],
  "indexes": [
    {
      "id": "i1",
      "fields": [
        "trang_thai",
        "buoc_hien_tai"
      ]
    },
    {
      "id": "i2",
      "fields": [
        "nguoi_de_nghi"
      ]
    }
  ],
  "rules": [
    {
      "id": "r1",
      "message": "Người duyệt cuối không được là người đề nghị (tách nhiệm vụ)",
      "check": {
        "field": "nguoi_duyet_cuoi",
        "op": "!=",
        "other_field": "nguoi_de_nghi"
      }
    },
    {
      "id": "r2",
      "message": "Đề xuất đã duyệt/đã chi phải có người duyệt cuối và thời điểm duyệt",
      "check": {
        "or": [
          {
            "not": {
              "field": "trang_thai",
              "op": "in",
              "value": [
                "da_duyet",
                "da_chi"
              ]
            }
          },
          {
            "and": [
              {
                "field": "nguoi_duyet_cuoi",
                "op": "not_null"
              },
              {
                "field": "ngay_duyet",
                "op": "not_null"
              }
            ]
          }
        ]
      }
    }
  ],
  "permissions": {
    "nhan_vien": {
      "actions": [
        "read"
      ],
      "scope": "own"
    },
    "truong_bo_phan": {
      "actions": [
        "read"
      ],
      "scope": "department"
    },
    "ke_toan_thanh_toan": {
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    "ke_toan_truong": {
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    "giam_doc": {
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    "xt_workflow": {
      "actions": [
        "create",
        "read",
        "update"
      ],
      "scope": "all"
    }
  }
}
