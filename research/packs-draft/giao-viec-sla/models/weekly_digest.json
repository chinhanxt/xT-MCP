{
  "id": "tsk_digest",
  "name": "weekly_digest",
  "label": "Bản tin tuần",
  "title_field": "code",
  "fields": [
    {
      "id": "f1",
      "name": "code",
      "type": "text",
      "label": "Mã bản tin",
      "required": true,
      "unique": true,
      "regex": "^BT-[0-9]{4}-W[0-9]{2}(-[A-Z]{2,6})?$"
    },
    {
      "id": "f2",
      "name": "from_date",
      "type": "date",
      "label": "Từ ngày",
      "required": true
    },
    {
      "id": "f3",
      "name": "to_date",
      "type": "date",
      "label": "Đến ngày",
      "required": true
    },
    {
      "id": "f4",
      "name": "department",
      "type": "text",
      "label": "Phòng ban (rỗng = toàn công ty)",
      "max": 20
    },
    {
      "id": "f5",
      "name": "total_assigned",
      "type": "number",
      "label": "Số việc giao mới",
      "required": true,
      "min": 0,
      "default": 0
    },
    {
      "id": "f6",
      "name": "total_completed",
      "type": "number",
      "label": "Số việc hoàn thành",
      "required": true,
      "min": 0,
      "default": 0
    },
    {
      "id": "f7",
      "name": "total_overdue",
      "type": "number",
      "label": "Số việc quá hạn",
      "required": true,
      "min": 0,
      "default": 0
    },
    {
      "id": "f8",
      "name": "total_blocked",
      "type": "number",
      "label": "Số việc đang bị chặn",
      "required": true,
      "min": 0,
      "default": 0
    },
    {
      "id": "f9",
      "name": "content",
      "type": "text",
      "label": "Nội dung bản tin",
      "max": 8000
    },
    {
      "id": "f10",
      "name": "detail",
      "type": "json",
      "label": "Chi tiết (kèm id bản ghi gốc)"
    },
    {
      "id": "f11",
      "name": "sent",
      "type": "bool",
      "label": "Đã gửi",
      "required": true,
      "default": false
    }
  ],
  "indexes": [
    {
      "id": "i1",
      "fields": [
        "from_date"
      ]
    }
  ],
  "rules": [
    {
      "id": "r1",
      "message": "'Đến ngày' phải sau hoặc bằng 'Từ ngày'",
      "check": {
        "field": "to_date",
        "op": ">=",
        "other_field": "from_date"
      }
    }
  ],
  "permissions": {
    "dept_head": {
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    "director": {
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    "employee": {
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    "xt_workflow": {
      "actions": [
        "create",
        "read",
        "update"
      ],
      "scope": "all"
    }
  }
}
