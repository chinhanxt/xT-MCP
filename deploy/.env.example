# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: 2026 xT contributors
# Mẫu cấu hình deploy. `make env` (hoặc provision.py) sao chép thành deploy/.env (không commit)
# và tự sinh giá trị cho mọi biến bí mật còn để trống (đánh dấu [tự sinh]).

# --- Hostname công khai (APISIX định tuyến theo Host) ---
XT_DOMAIN_DESK=xt.freepro.online
XT_DOMAIN_MCP=xt-mcp.freepro.online
XT_DOMAIN_API=xt-api.freepro.online
XT_DOMAIN_AUTH=xt-auth.freepro.online

# --- Cổng publish (chỉ bind 127.0.0.1) ---
APISIX_HTTP_PORT=9080
# Cổng Keycloak cho provision.py (Admin REST); không đi qua APISIX
KC_HTTP_PORT=18080

# --- Postgres ---
POSTGRES_USER=xt
POSTGRES_DB=xt
POSTGRES_PASSWORD=           # [tự sinh]
XT_PGRST_PASSWORD=           # [tự sinh] mật khẩu role xt_authenticator (LOGIN của PostgREST); truyền vào tenancy.install_postgrest_role

# Mật khẩu role DB của xT (xt-init tạo/đặt; xt-api dùng xt_app + xt_migrator, xt-worker dùng xt_app + xt_control)
XT_DB_APP_PASSWORD=          # [tự sinh]
XT_DB_MIGRATOR_PASSWORD=     # [tự sinh]
XT_DB_CONTROL_PASSWORD=      # [tự sinh]

# --- Keycloak ---
XT_REALM=xt
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD= # [tự sinh]
KC_HEAP="-Xms128m -Xmx384m -XX:MaxMetaspaceSize=192m"

# --- Danh tính xT (docs/identity.md) ---
XT_IDP_INTROSPECTION=high_risk
XT_IDP_INTROSPECTION_CLIENT_ID=xt-api-introspect
XT_IDP_INTROSPECTION_CLIENT_SECRET= # [tự sinh]
# Client DCR của ChatGPT/Claude có client_id ngẫu nhiên: thêm vào đây sau khi đăng ký (identity.md, giới hạn hiện tại)
# Allowlist động cho connector DCR (docs/identity.md): xT tra Keycloak bằng service account view-clients
XT_MCP_CLIENT_REGISTRY=keycloak
XT_IDP_ADMIN_CLIENT_ID=xt-client-registry
XT_IDP_ADMIN_CLIENT_SECRET= # [tự sinh]
XT_MCP_CONNECTOR_REDIRECT_HOSTS=chatgpt.com,claude.ai,127.0.0.1
XT_MCP_ALLOWED_CLIENTS=xt-desk-agent
XT_MCP_HUMAN_CLIENTS=xt-desk
# Client của CHAT Desk (agent thay mặt người dùng, client public): tier masked; giá trị thật chỉ qua /pii/reveal (kênh người).
# Desk dùng client này cho MCP, KHÔNG dùng xt-desk/xt-desk-confirm. xt-api cho client này xin vé pii_reveal_ticket.
XT_DESK_AGENT_CLIENT_ID=xt-desk-agent
# Chỉ client confidential phía server (vd. Desk BFF tương lai). KHÔNG đặt client public như xt-desk-agent.
XT_MCP_LOCAL_CLIENTS=
# Danh sách client confidential phía server được phép nằm trong XT_MCP_LOCAL_CLIENTS.
XT_MCP_CONFIDENTIAL_CLIENTS=
# Quota vé xem PII (/pii/reveal) mỗi người mỗi phút; gateway còn limit-req theo IP (route desk-pii)
XT_PII_REVEAL_TICKETS_PER_MINUTE=10
# Profile triển khai: để trống/production = realm KHÔNG có redirect loopback cho xt-desk-agent; dev = thêm các URI bên dưới
XT_PROFILE=
# Redirect loopback cho dev Desk (vite) của xt-desk-agent; CHỈ dùng khi XT_PROFILE=dev
XT_DESK_AGENT_DEV_REDIRECTS=http://localhost:5173/auth/callback,http://127.0.0.1:5173/auth/callback
XT_MCP_REQUIRED_SCOPES=mcp-xt
XT_MCP_SCOPES_SUPPORTED="mcp-xt openid profile email"
XT_CONFIRM_CLIENT_ID=xt-desk-confirm
XT_CONFIRM_ACR=urn:xt:acr:otp
XT_CONFIRM_REQUIRED_AMR=otp
# Phân cách dấu phẩy. 127.0.0.1 cho Claude Code (loopback http, khớp trusted-hosts + client policy); bỏ nếu không cần
XT_DCR_TRUSTED_HOSTS=chatgpt.com,claude.ai,127.0.0.1
# Role nghiệp vụ phải có TOTP (research/packs-draft/*/policies)
XT_TOTP_ROLES=dept_head,director,chief_accountant,payment_accountant,hr,hr_pii,it_admin,admin

# --- xT worker (xt worker) ---
# Handler thật: workflow.tick + workflow.relay_timers + model.apply (composition/worker.py)
XT_WORKER_HANDLERS=xt.entrypoints.composition.worker:handlers
# Chu kỳ (giây, >= 5) relay outbox hẹn giờ SLA + đề xuất model đã duyệt sang hàng đợi. Sau khi tạo tenant:
#   docker compose run --rm xt-init xt tenant bind-queue --tenant <alias>
XT_WORKFLOW_RELAY_SECONDS=60
XT_WORKER_CONCURRENCY=2
XT_WORKER_STALLED_SECONDS=30
XT_WORKER_RECOVER_SECONDS=5       # phải < STALLED/2
XT_WORKER_MAX_ATTEMPTS=3
XT_WORKER_RETRY_SECONDS=30
# xt serve: module:factory trả ToolServices/composition (bắt buộc cho xt-api thật)
XT_MCP_SERVICES=xt.entrypoints.composition:build
# Khóa tệp (audit/cursor/pii/biên nhận Ed25519) do `make env` sinh ở ${XT_SECRETS_DIR:-~/.config/xt}/app, mount vào /run/secrets/xt
XT_AUDIT_KEY_ID=1
XT_RECEIPT_TTL_SECONDS=300

# --- xT Desk (build arg của desk/Dockerfile; desk/.env.example giải thích từng biến) ---
DESK_LLM_URL=http://ollama:11434/v1
DESK_LLM_MODEL=qwen3.5:4b
DESK_LLM_REASONING_EFFORT=none
DESK_TOOL_PROFILE=core-10
DESK_MAX_STEPS=6
DESK_AUTH_MODE=oidc
# Sandbox MCP Apps phải KHÁC origin với Desk: dùng host xt-api (APISIX phục vụ /sandbox.html ở đó)
DESK_APP_CALLS_PER_SEC=5
DESK_APP_CALL_BURST=10
DESK_APP_MAX_INFLIGHT=4
DESK_APP_MAX_ARGS_BYTES=32768
DESK_APP_GLOBAL_CALLS_PER_SEC=10
DESK_APP_GLOBAL_BURST=20

# --- Profile full ---
OLLAMA_CONTEXT_LENGTH=16384
OPENBAO_DEV_TOKEN=           # [tự sinh] chỉ dùng cho OpenBao dev mode

# --- Profile public (Cloudflare Tunnel) ---
# Lấy từ ~/.config/xt/tunnel_token (docs/deployment-public.md). Không commit.
TUNNEL_TOKEN=

# PostgREST /data. JWKS nằm ngoài repo; nạp bằng `make pgrst-jwks` (sau khi Keycloak chạy).
XT_SECRETS_DIR=              # mặc định ~/.config/xt
# Client được phép xin scope `xt-data` (aud xt-data, claim data_role=xt_web, organization). Danh sách clientId tường minh,
# phân tách bằng dấu phẩy; không wildcard. Scope là OPTIONAL theo từng client (không phải default của realm/DCR);
# client ngoài danh sách bị thu hồi. Client phải có sẵn và đang bật. Cấp bằng: make -C deploy provision-data
# Rỗng = provision-data từ chối chạy. CÙNG danh sách này phải được ghi vào xt_meta.pgrst_client (azp allowlist của
# xt.pgrst_pre) qua install_postgrest_role; hai nơi lệch nhau thì token bị SQL từ chối (fail-closed).
XT_DATA_CLIENTS=
# Client được xin scope xt-workflow (REST /workflow/v1). Trống = xt-cli. Không được chứa client MCP/Desk.
# Cùng biến này đặt XT_WORKFLOW_ALLOWED_CLIENTS của xt-api (compose.yaml) nên token của các client này được nhận.
XT_WORKFLOW_CLIENTS=
# Issuer mà xt.pgrst_pre so với claim iss (PostgREST không tự kiểm iss) và fetch_jwks đối chiếu với discovery.
# Mặc định https://$XT_DOMAIN_AUTH/realms/$XT_REALM; in ra bằng `make -C deploy pgrst-issuer` để truyền vào
# install_postgrest_role(..., issuer=...). Chỉ đặt khi Keycloak công bố issuer khác.
XT_PGRST_ISSUER=
