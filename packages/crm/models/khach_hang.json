    "sales_manager": {"actions": ["create", "read", "update"], "scope": "all"},
    "director": {"actions": ["read"], "scope": "all"},
    "admin": {"actions": ["create", "read", "update"], "scope": "all"},
    "agent": {"actions": ["read"], "scope": "all"}
