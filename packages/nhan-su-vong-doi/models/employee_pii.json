{
  "id": "hr_emp_pii",
  "name": "employee_pii",
  "label": "Hồ sơ nhân sự nhạy cảm",
  "title_field": "employee",
  "fields": [
    {
      "id": "f1",
      "name": "employee",
      "type": "ref",
      "label": "Nhân viên",
      "required": true,
      "unique": true,
      "ref": "employee"
    },
    {
      "id": "f2",
      "name": "national_id",
      "type": "text",
      "label": "Số CCCD",
      "regex": "^[0-9]{12}$"
    },
    {
      "id": "f3",
      "name": "phone",
      "type": "text",
      "label": "Số điện thoại",
      "regex": "^0[0-9]{9}$"
    },
    {
      "id": "f4",
      "name": "bank_account",
      "type": "text",
      "label": "Số tài khoản ngân hàng",
      "regex": "^[0-9]{6,20}$"
    },
    {
      "id": "f5",
      "name": "base_salary",
      "type": "money",
      "label": "Lương cơ bản (VND/tháng)",
      "min": 0
    }
  ],
  "indexes": [],
  "rules": [],
  "permissions": {
    "hr_pii": {
      "actions": [
        "create",
        "read",
        "update"
      ],
      "scope": "all"
    },
    "employee": {
      "actions": [
        "read"
      ],
      "scope": "own"
    },
    "xt_workflow": {
      "actions": [
        "read"
      ],
      "scope": "all"
    }
  }
}
