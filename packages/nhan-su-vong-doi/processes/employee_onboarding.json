{
  "id": "employee_onboarding",
  "name": "Tiếp nhận nhân sự mới (HR, IT, Kế toán, Quản lý)",
  "version": 1,
  "roles": ["hr", "it_admin", "payment_accountant", "chief_accountant", "dept_head", "director"],
  "steps": [
    {"id": "init", "type": "service", "name": "Sinh checklist liên phòng ban", "op": "create_lifecycle_tasks",
     "params": {"case_id": "case_id", "kind": "'onboarding'"}},
    {"id": "hr", "type": "approve", "name": "Nhân sự: hồ sơ, HĐLĐ, BHXH", "role": "hr",
     "sla": {"after": "PT24H", "escalate_to": "director"}},
    {"id": "it", "type": "approve", "name": "IT: email, tài khoản, thiết bị", "role": "it_admin",
     "sla": {"after": "PT24H", "escalate_to": "director"}},
    {"id": "accounting", "type": "approve", "name": "Kế toán: mã lương, tài khoản nhận lương", "role": "payment_accountant",
     "sla": {"after": "PT24H", "escalate_to": "chief_accountant"}},
    {"id": "manager", "type": "approve", "name": "Quản lý: buddy và kế hoạch 30-60-90", "role": "dept_head",
     "sla": {"after": "PT48H", "escalate_to": "director"}},
    {"id": "activate", "type": "service", "name": "Kích hoạt nhân viên", "op": "activate_employee",
     "params": {"employee_id": "employee_id"}}
  ]
}
