{
  "name": "xt-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit && node config/build.mjs",
    "start": "node src/server.ts",
    "dev": "npm run build && node --watch src/server.ts",
    "test": "node --test tests/*.test.ts",
    "format": "prettier --config config/prettier.json --write src tests config",
    "test:live": "node tests/live-smoke.ts",
    "map-legacy": "node src/map-legacy.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xyflow/react": "^12.9.0",
    "ajv": "^8.20.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.0"
  },
  "license": "Apache-2.0"
}
