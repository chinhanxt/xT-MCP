{
  "id": "dx_tamung",
  "name": "tam_ung",
  "label": "Giấy đề nghị tạm ứng",
  "title_field": "de_xuat",
  "fields": [
    {
      "id": "f1",
      "name": "de_xuat",
      "type": "ref",
      "label": "Đề xuất",
      "required": true,
      "unique": true,
      "ref": "de_xuat"
    },
    {
      "id": "f2",
      "name": "ngay_lap",
      "type": "date",
      "label": "Ngày lập",
      "required": true
    },
    {
      "id": "f3",
      "name": "so_tien",
      "type": "money",
      "label": "Số tiền tạm ứng (VND)",
      "required": true,
      "min": 100000,
      "max": 30000000
    },
    {
      "id": "f4",
      "name": "ngay_di",
      "type": "date",
      "label": "Ngày đi",
      "required": true
    },
    {
      "id": "f5",
      "name": "ngay_ve",
      "type": "date",
      "label": "Ngày về",
      "required": true
    },
    {
      "id": "f6",
      "name": "dia_diem",
      "type": "text",
      "label": "Nơi công tác",
      "max": 200
    },
    {
      "id": "f7",
      "name": "thoi_han_hoan_ung",
      "type": "date",
      "label": "Thời hạn thanh toán/hoàn ứng",
      "required": true
    },
    {
      "id": "f8",
      "name": "hinh_thuc_nhan",
      "type": "enum",
      "label": "Hình thức nhận tiền",
      "required": true,
      "options": [
        {
          "value": "tien_mat",
          "label": "Tiền mặt"
        },
        {
          "value": "chuyen_khoan",
          "label": "Chuyển khoản"
        }
      ]
    },
    {
      "id": "f9",
      "name": "ngan_hang",
      "type": "text",
      "label": "Ngân hàng thụ hưởng",
      "max": 100
    },
    {
      "id": "f10",
      "name": "so_tai_khoan",
      "type": "text",
      "label": "Số tài khoản thụ hưởng",
      "regex": "^[0-9]{6,20}$"
    },
    {
      "id": "f11",
      "name": "da_hoan_ung",
      "type": "bool",
      "label": "Đã hoàn ứng",
      "required": true,
      "default": false
    }
  ],
  "indexes": [
    {
      "id": "i1",
      "fields": [
        "thoi_han_hoan_ung",
        "da_hoan_ung"
      ]
    }
  ],
  "rules": [
    {
      "id": "r1",
      "message": "'Ngày về' phải sau hoặc bằng 'Ngày đi'",
      "check": {
        "field": "ngay_ve",
        "op": ">=",
        "other_field": "ngay_di"
      }
    },
    {
      "id": "r2",
      "message": "'Thời hạn hoàn ứng' phải sau hoặc bằng 'Ngày về'",
      "check": {
        "field": "thoi_han_hoan_ung",
        "op": ">=",
        "other_field": "ngay_ve"
      }
    },
    {
      "id": "r3",
      "message": "Nhận chuyển khoản thì phải có số tài khoản",
      "check": {
        "or": [
          {
            "field": "hinh_thuc_nhan",
            "op": "!=",
            "value": "chuyen_khoan"
          },
          {
            "field": "so_tai_khoan",
            "op": "not_null"
          }
        ]
      }
    }
  ],
  "permissions": {
    "nhan_vien": {
      "actions": [
        "read"
      ],
      "scope": "own"
    },
    "truong_bo_phan": {
      "actions": [
        "read"
      ],
      "scope": "department"
    },
    "ke_toan_thanh_toan": {
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    "ke_toan_truong": {
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    "giam_doc": {
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    "xt_workflow": {
      "actions": [
        "create",
        "read",
        "update"
      ],
      "scope": "all"
    }
  }
}
