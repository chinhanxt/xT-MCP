{
  "version": "1",
  "tenant": "binhminh",
  "statements": [
    {
      "id": "wh.read",
      "effect": "Allow",
      "subjects": [
        "role:employee",
        "role:warehouse_manager",
        "role:admin",
        "role:agent"
      ],
      "actions": [
        "record.read"
      ],
      "resources": [
        "xrn:binhminh:warehouse:*",
        "xrn:binhminh:warehouse_location:*",
        "xrn:binhminh:stock_item:*",
        "xrn:binhminh:stock_request:*",
        "xrn:binhminh:stock_balance:*",
        "xrn:binhminh:stock_movement:*"
      ],
      "conditions": []
    },
    {
      "id": "wh.catalog",
      "effect": "Allow",
      "subjects": [
        "role:warehouse_manager",
        "role:admin"
      ],
      "actions": [
        "record.create",
        "record.update"
      ],
      "resources": [
        "xrn:binhminh:warehouse:*",
        "xrn:binhminh:warehouse_location:*",
        "xrn:binhminh:stock_item:*"
      ],
      "conditions": []
    },
    {
      "id": "wh.request-write",
      "effect": "Allow",
      "subjects": [
        "role:employee",
        "role:warehouse_manager",
        "role:admin",
        "role:agent"
      ],
      "actions": [
        "record.create",
        "record.update",
        "request.submit",
        "record.transition"
      ],
      "resources": [
        "xrn:binhminh:stock_request:*"
      ],
      "conditions": [
        {
          "left": "resource.owner",
          "op": "eq",
          "right": {
            "ref": "subject.id"
          }
        }
      ]
    },
    {
      "id": "wh.approve",
      "effect": "Allow",
      "subjects": [
        "role:warehouse_manager"
      ],
      "actions": [
        "record.approve",
        "request.decide"
      ],
      "resources": [
        "xrn:binhminh:stock_request:*"
      ],
      "conditions": []
    },
    {
      "id": "wh.deny-agent-approve",
      "effect": "Deny",
      "subjects": [
        "role:agent"
      ],
      "actions": [
        "record.approve",
        "request.decide"
      ],
      "resources": [
        "xrn:binhminh:stock_request:*"
      ],
      "conditions": []
    },
    {
      "id": "wh.deny-ledger-write",
      "effect": "Deny",
      "subjects": [
        "*"
      ],
      "actions": [
        "record.create",
        "record.update",
        "record.delete"
      ],
      "resources": [
        "xrn:binhminh:stock_balance:*",
        "xrn:binhminh:stock_movement:*"
      ],
      "conditions": []
    },
    {
      "id": "wh.deny-delete",
      "effect": "Deny",
      "subjects": [
        "*"
      ],
      "actions": [
        "record.delete"
      ],
      "resources": [
        "xrn:binhminh:warehouse:*",
        "xrn:binhminh:warehouse_location:*",
        "xrn:binhminh:stock_item:*",
        "xrn:binhminh:stock_request:*",
        "xrn:binhminh:stock_balance:*",
        "xrn:binhminh:stock_movement:*"
      ],
      "conditions": []
    },
    {
      "id": "wh.tools",
      "effect": "Allow",
      "subjects": [
        "role:employee",
        "role:warehouse_manager",
        "role:admin",
        "role:agent"
      ],
      "actions": [
        "workspace.read",
        "model.read",
        "process.read",
        "person.read",
        "record.search",
        "inbox.read",
        "history.read"
      ],
      "resources": [
        "xrn:binhminh:*"
      ],
      "conditions": []
    }
  ]
}
