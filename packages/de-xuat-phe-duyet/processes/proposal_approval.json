{
  "id": "proposal_approval",
  "name": "Đề xuất và phê duyệt đa cấp (Tạm ứng / Thanh toán / Hoàn ứng)",
  "version": 3,
  "roles": [
    "dept_head",
    "payment_accountant",
    "chief_accountant",
    "director"
  ],
  "inputs": {
    "kind": {
      "type": "str",
      "description": "advance_request | payment_request | advance_settlement"
    },
    "amount": {
      "type": "int",
      "editable_on_revision": true,
      "description": "Số tiền (VND)"
    },
    "note": {
      "type": "str",
      "required": false,
      "editable_on_revision": true
    }
  },
  "fallback_assignee": "role(director)",
  "steps": [
    {
      "id": "chk_overdue",
      "type": "service",
      "name": "Kiểm tra công nợ tạm ứng quá hạn",
      "op": "check_overdue_advances",
      "params": {
        "requester": "requester"
      },
      "when": "kind == 'advance_request'"
    },
    {
      "id": "dept_head",
      "type": "approve",
      "name": "Trưởng bộ phận duyệt",
      "assignee": {
        "kind": "department_head",
        "department_of": "requester",
        "fallback": [
          "requester.manager"
        ]
      },
      "outcomes": [
        "approve",
        "reject",
        "return_for_revision",
        "delegate",
        "request_info"
      ],
      "sla": {
        "after": "PT24H",
        "escalate_to": "requester.manager"
      }
    },
    {
      "id": "kttt",
      "type": "approve",
      "name": "Kế toán thanh toán kiểm chứng từ",
      "assignee": "role(payment_accountant)",
      "when": "kind in ('payment_request', 'advance_settlement')",
      "outcomes": [
        "approve",
        "reject",
        "return_for_revision",
        "request_info"
      ],
      "sla": {
        "after": "PT24H",
        "escalate_to": "role(chief_accountant)"
      }
    },
    {
      "id": "chief_acct_overdue",
      "type": "approve",
      "name": "Kế toán trưởng xem xét nợ tạm ứng quá hạn",
      "assignee": "role(chief_accountant)",
      "when": "kind == 'advance_request' and chk_overdue_result['overdue'] > 0",
      "sla": {
        "after": "PT24H",
        "escalate_to": "role(director)"
      }
    },
    {
      "id": "ktt",
      "type": "approve",
      "name": "Kế toán trưởng duyệt",
      "assignee": "role(chief_accountant)",
      "when": "amount > 50000000",
      "sod": {
        "distinct_from": [
          "kttt"
        ]
      },
      "sla": {
        "after": "PT24H",
        "escalate_to": "role(director)"
      }
    },
    {
      "id": "director",
      "type": "approve",
      "name": "Giám đốc duyệt",
      "assignee": "role(director)",
      "when": "amount > 5000000",
      "outcomes": [
        "approve",
        "reject",
        "return_for_revision"
      ],
      "on_return": {
        "resume": "restart",
        "max_rounds": 2
      }
    }
  ],
  "description": "v0.1: bước ghi sổ (post_to_ledger) gỡ cho tới khi có module kế toán; quyết định duyệt cuối được ghi vào trạng thái đề nghị."
}
