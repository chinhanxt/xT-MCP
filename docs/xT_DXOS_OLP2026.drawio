<mxfile host="app.diagrams.net" type="device"><diagram id="p1" name="1. Đề thi - 3 tầng &amp; 7 lớp"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_1" value="&lt;b&gt;DX-OS Open-Core — OLP Phần mềm Nguồn mở 2026&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;Tháp 3 tầng · 7 lớp công nghệ tham chiếu · Chuỗi tiến hóa H-P-D-I · 4 nguyên lý thiết kế&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1660" height="50" as="geometry"/></mxCell><mxCell id="p1_2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1000" height="180" as="geometry"/></mxCell><mxCell id="p1_3" value="&lt;b&gt;TẦNG 3 — NỀN TẢNG KINH DOANH SỐ&lt;/b&gt; &amp;nbsp;&lt;i&gt;(ứng dụng chuyên ngành, cắm–rút linh hoạt · không bắt buộc)&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="55" y="84" width="970" height="30" as="geometry"/></mxCell><mxCell id="p1_4" value="&lt;b&gt;Dòng chảy Hàng hóa&lt;/b&gt;&lt;br&gt;• OMS – đơn hàng&lt;br&gt;• WMS – kho bãi&lt;br&gt;• POS – điểm bán&lt;br&gt;• TMS – vận tải" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="237" height="130" as="geometry"/></mxCell><mxCell id="p1_5" value="&lt;b&gt;Thời gian &amp; Dự án&lt;/b&gt;&lt;br&gt;• PSA – dịch vụ chuyên nghiệp&lt;br&gt;• Timesheet – giờ công&lt;br&gt;• CDE + BIM 3D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="297" y="120" width="237" height="130" as="geometry"/></mxCell><mxCell id="p1_6" value="&lt;b&gt;Trải nghiệm &amp; Thuê bao&lt;/b&gt;&lt;br&gt;• eKYC / AML&lt;br&gt;• LMS – học tập&lt;br&gt;• EMR – bệnh án&lt;br&gt;• CRM – khách hàng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="544" y="120" width="237" height="130" as="geometry"/></mxCell><mxCell id="p1_7" value="&lt;b&gt;Tài sản &amp; Không gian&lt;/b&gt;&lt;br&gt;• MES / SCADA&lt;br&gt;• BMS – tòa nhà&lt;br&gt;• Smart City IoT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="791" y="120" width="237" height="130" as="geometry"/></mxCell><mxCell id="p1_8" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="275" width="1000" height="260" as="geometry"/></mxCell><mxCell id="p1_9" value="&lt;b&gt;TẦNG 2 — KHÔNG GIAN NĂNG LỰC SỐ (H-P-D-I)&lt;/b&gt; &amp;nbsp;&lt;i&gt;(có giao diện người dùng cuối · bắt buộc ≥ 1 ứng dụng minh họa, 1 không gian là đủ)&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="55" y="279" width="970" height="30" as="geometry"/></mxCell><mxCell id="p1_10" value="&lt;b&gt;[H] Con người số&lt;/b&gt;&lt;br&gt;• Cổng giao tiếp điện tử tập trung&lt;br&gt;• Ổ đĩa lưu trữ đám mây&lt;br&gt;• Kanban &amp; Lịch&lt;br&gt;• Wiki – quản trị tri thức&lt;br&gt;• App di động hiện trường" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="315" width="237" height="210" as="geometry"/></mxCell><mxCell id="p1_11" value="&lt;b&gt;[P] Quy trình số&lt;/b&gt;&lt;br&gt;• Thanh toán &amp; đối soát&lt;br&gt;• Hóa đơn điện tử&lt;br&gt;• Giải mã tài liệu trên RAM&lt;br&gt;• e-Office&lt;br&gt;• Nhân sự &amp; KPIs&lt;br&gt;• Dự án &amp; kế hoạch&lt;br&gt;• Thiết kế form / BPMN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="297" y="315" width="237" height="210" as="geometry"/></mxCell><mxCell id="p1_12" value="&lt;b&gt;[D] Dữ liệu số&lt;/b&gt;&lt;br&gt;• &lt;i&gt;Ấm:&lt;/i&gt; NGSI-LD, Lakehouse,&lt;br&gt;• WebGIS, IOC/BI, DaaS,&lt;br&gt;• Data Lineage&lt;br&gt;• &lt;i&gt;Lạnh:&lt;/i&gt; phòng đọc chống sửa xóa,&lt;br&gt;• sổ cái mật mã bất biến" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="544" y="315" width="237" height="210" as="geometry"/></mxCell><mxCell id="p1_13" value="&lt;b&gt;[I] Trí tuệ số&lt;/b&gt;&lt;br&gt;• Tìm kiếm toàn văn + véc-tơ&lt;br&gt;• Cổng quản trị AI Agents&lt;br&gt;• OCR bóc tách văn bản&lt;br&gt;• Trợ lý ảo RAG nội bộ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="791" y="315" width="237" height="210" as="geometry"/></mxCell><mxCell id="p1_14" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="1000" height="345" as="geometry"/></mxCell><mxCell id="p1_15" value="&lt;b&gt;TẦNG 1 — NỀN TẢNG DỊCH VỤ LÕI SỐ (Headless PaaS)&lt;/b&gt; &amp;nbsp;&lt;i&gt;(chạy ngầm · KHÔNG có UI · phục vụ tầng trên)&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="55" y="554" width="970" height="30" as="geometry"/></mxCell><mxCell id="p1_16" value="&lt;b&gt;★ Định danh, Bảo mật &amp; ATTT&lt;/b&gt;&lt;br&gt;• SSO, MFA&lt;br&gt;• Két sắt khóa / bí mật&lt;br&gt;• Kiểm dịch tệp tin&lt;br&gt;• PKI, HSM, chữ ký số" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="590" width="237" height="140" as="geometry"/></mxCell><mxCell id="p1_17" value="&lt;b&gt;Đa thuê ước, Biên mạng &amp; Cá thể hóa&lt;/b&gt;&lt;br&gt;• ★ API Gateway zero-trust&lt;br&gt;• Che giấu PII&lt;br&gt;• Multi-tenancy&lt;br&gt;• Đa ngôn ngữ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="297" y="590" width="237" height="140" as="geometry"/></mxCell><mxCell id="p1_18" value="&lt;b&gt;★ Dữ liệu có cấu trúc &amp; Giao dịch&lt;/b&gt;&lt;br&gt;• OLTP toàn vẹn&lt;br&gt;• Tự sinh API + RLS&lt;br&gt;• Phiên bản / lịch sử&lt;br&gt;• Chuỗi thời gian, semantic layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="544" y="590" width="237" height="140" as="geometry"/></mxCell><mxCell id="p1_19" value="&lt;b&gt;★ Dữ liệu phi cấu trúc &amp; Hồ sơ&lt;/b&gt;&lt;br&gt;• Object storage&lt;br&gt;• Hồ sơ / văn bản phê duyệt&lt;br&gt;• Đánh chỉ mục toàn văn&lt;br&gt;• Trộn dữ liệu sinh biểu mẫu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="791" y="590" width="237" height="140" as="geometry"/></mxCell><mxCell id="p1_20" value="&lt;b&gt;★ Quy trình &amp; Tự động hóa&lt;/b&gt;&lt;br&gt;• BPMN – luồng phê duyệt&lt;br&gt;• Serverless script&lt;br&gt;• Nạp dữ liệu theo lô" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="740" width="237" height="140" as="geometry"/></mxCell><mxCell id="p1_21" value="&lt;b&gt;Vận hành, Giám sát &amp; Kiểm toán&lt;/b&gt;&lt;br&gt;• Log truy vết, audit bất biến&lt;br&gt;• Event streaming&lt;br&gt;• GitOps&lt;br&gt;• Sao lưu / khôi phục" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="297" y="740" width="237" height="140" as="geometry"/></mxCell><mxCell id="p1_22" value="&lt;b&gt;Truyền thông &amp; Giao vận&lt;/b&gt;&lt;br&gt;• Định tuyến đa kênh&lt;br&gt;• WebSocket realtime&lt;br&gt;• Hàng đợi bất đồng bộ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="544" y="740" width="237" height="140" as="geometry"/></mxCell><mxCell id="p1_23" value="&lt;b&gt;★ BẮT BUỘC (Mục 3)&lt;/b&gt;&lt;br&gt;1. Identity / SSO&lt;br&gt;2. API Gateway&lt;br&gt;3. Dữ liệu cấu trúc / phi cấu trúc&lt;br&gt;4. Workflow engine&lt;br&gt;&lt;i&gt;Tham khảo: Supabase · Strapi · Directus&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="791" y="740" width="237" height="140" as="geometry"/></mxCell><mxCell id="p1_24" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1070" y="80" width="630" height="815" as="geometry"/></mxCell><mxCell id="p1_25" value="&lt;b&gt;7 LỚP CÔNG NGHỆ THAM CHIẾU&lt;/b&gt; &lt;i&gt;(ví dụ — đội thi tự chọn)&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1085" y="84" width="600" height="30" as="geometry"/></mxCell><mxCell id="p1_26" value="&lt;b&gt;Lớp 1 · Trải nghiệm &amp; Giao diện đa kênh&lt;/b&gt; &amp;nbsp;&lt;font color='#b85450'&gt;&lt;b&gt;→ Tầng 2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Nuxt 3 / Vue 3, Flutter, Centrifugo, Tailwind&lt;/i&gt;&lt;br&gt;UI Web/Mobile, realtime WebSocket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="122" width="610" height="102" as="geometry"/></mxCell><mxCell id="p1_27" value="&lt;b&gt;Lớp 2 · Biên mạng, Cửa ngõ &amp; ATTT&lt;/b&gt; &amp;nbsp;&lt;font color='#b85450'&gt;&lt;b&gt;→ Tầng 1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;APISIX, Keycloak, Vault, ClamAV, Coraza WAF&lt;/i&gt;&lt;br&gt;Zero-Trust, SSO/MFA, bí mật, kiểm dịch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="232" width="610" height="102" as="geometry"/></mxCell><mxCell id="p1_28" value="&lt;b&gt;Lớp 3 · Tác nghiệp, Logic &amp; Thực thể&lt;/b&gt; &amp;nbsp;&lt;font color='#b85450'&gt;&lt;b&gt;→ Tầng 1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Hasura GraphQL, PostgreSQL(+PostGIS), MongoDB, Orion&lt;/i&gt;&lt;br&gt;OLTP, tự sinh API, NGSI-LD, Digital Twin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="342" width="610" height="102" as="geometry"/></mxCell><mxCell id="p1_29" value="&lt;b&gt;Lớp 4 · Tự động hóa, Quy trình &amp; DevSecOps&lt;/b&gt; &amp;nbsp;&lt;font color='#b85450'&gt;&lt;b&gt;→ Tầng 1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;ArgoCD, GitLab CI, Flowable BPMN, Kestra, Velero &lt;font color='#b85450'&gt;(tránh n8n – phi OSI)&lt;/font&gt;&lt;/i&gt;&lt;br&gt;GitOps, luồng phê duyệt, backup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="452" width="610" height="102" as="geometry"/></mxCell><mxCell id="p1_30" value="&lt;b&gt;Lớp 5 · Dữ liệu hội tụ, Truyền phát &amp; Sổ cái&lt;/b&gt; &amp;nbsp;&lt;font color='#b85450'&gt;&lt;b&gt;→ Tầng 1 / [D]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Redpanda, Apache Iceberg, MinIO, ImmuDB&lt;/i&gt;&lt;br&gt;Event streaming, Lakehouse, sổ cái bất biến" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="562" width="610" height="102" as="geometry"/></mxCell><mxCell id="p1_31" value="&lt;b&gt;Lớp 6 · Phân tích, Không gian &amp; Trí tuệ&lt;/b&gt; &amp;nbsp;&lt;font color='#b85450'&gt;&lt;b&gt;→ Tầng 2 [D][I]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Trino, DuckDB, GeoServer, Metabase, Cube.dev, Ollama / vLLM&lt;/i&gt;&lt;br&gt;Truy vấn phân tán, GIS, BI, LLM nội bộ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="672" width="610" height="102" as="geometry"/></mxCell><mxCell id="p1_32" value="&lt;b&gt;Lớp 7 · Quản trị, Tìm kiếm &amp; Giám sát&lt;/b&gt; &amp;nbsp;&lt;font color='#b85450'&gt;&lt;b&gt;→ Tầng 1 / [I]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Vector, Parseable, OpenMetadata, Meilisearch, Qdrant, Prometheus/Grafana&lt;/i&gt;&lt;br&gt;Audit log, lineage, full-text + vector, giám sát" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="782" width="610" height="102" as="geometry"/></mxCell><mxCell id="p1_33" value="&lt;b&gt;CHUỖI TIẾN HÓA H → P → D → I&lt;/b&gt; &amp;nbsp;&lt;i&gt;(tuyến tính, không nhảy cóc)&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="915" width="1000" height="25" as="geometry"/></mxCell><mxCell id="p1_34" value="&lt;b&gt;[H] Human&lt;/b&gt;&lt;br&gt;SSO, chat, wiki, P.A.R.A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="945" width="215" height="70" as="geometry"/></mxCell><mxCell id="p1_35" value="&lt;b&gt;[P] Process&lt;/b&gt;&lt;br&gt;SOP, Poka-yoke, workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="295" y="945" width="215" height="70" as="geometry"/></mxCell><mxCell id="p1_36" value="&lt;b&gt;[D] Data&lt;/b&gt;&lt;br&gt;Single Source of Truth, BI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="550" y="945" width="215" height="70" as="geometry"/></mxCell><mxCell id="p1_37" value="&lt;b&gt;[I] Intelligence&lt;/b&gt;&lt;br&gt;LLM, RAG, AI Agents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="805" y="945" width="215" height="70" as="geometry"/></mxCell><mxCell id="p1_38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_34" target="p1_35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_35" target="p1_36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_36" target="p1_37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_41" value="&lt;b&gt;Human-in-the-Loop:&lt;/b&gt; thao tác thủ công giảm từ 100% → 10–20%; con người chuyển sang giám sát chất lượng &amp;amp; &lt;b&gt;phê duyệt ngoại lệ&lt;/b&gt;. AI ở [I] chỉ đáng tin khi [P] có Poka-yoke và [D] sạch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1025" width="1000" height="50" as="geometry"/></mxCell><mxCell id="p1_42" value="&lt;b&gt;4 NGUYÊN LÝ THIẾT KẾ (Mục 4)&lt;/b&gt;&lt;br&gt;(i) Phân tách theo vòng đời &amp;amp; tốc độ dữ liệu — OLTP nhanh, lịch sử đẩy xuống hồ dữ liệu&lt;br&gt;(ii) Hội tụ dữ liệu IT &amp;amp; OT — quy trình + cảm biến → Digital Twin&lt;br&gt;(iii) Quản trị dữ liệu thế hệ mới — Data Lineage, nguồn gốc, chất lượng&lt;br&gt;(iv) Zero-Trust + GitOps — kiểm dịch tại biên, hạ tầng bằng mã, tự phục hồi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1070" y="915" width="630" height="160" as="geometry"/></mxCell><mxCell id="p1_43" value="&lt;b&gt;BỐI CẢNH — 2 THÁI CỰC THẤT BẠI&lt;/b&gt;&lt;br&gt;1. Phần mềm rời rạc → &lt;i&gt;ốc đảo dữ liệu&lt;/i&gt;, GIGO&lt;br&gt;2. Hệ nguyên khối đóng → &lt;i&gt;vendor lock-in&lt;/i&gt;, mất &lt;b&gt;chủ quyền số&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lời giải: DX-OS 3 tầng + Open-Core&lt;br&gt;Kế thừa OLP 2023 (LLM/RAG → [I]), 2024 (Low-code → [P]), 2025 (Linked Open Data → [D])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1095" width="325" height="175" as="geometry"/></mxCell><mxCell id="p1_44" value="&lt;b&gt;YÊU CẦU NỘP BÀI&lt;/b&gt;&lt;br&gt;• Giấy phép OSI, repo công khai có web viewer&lt;br&gt;• Release định dạng mở (.tar.gz), có số phiên bản&lt;br&gt;• README, hướng dẫn build, Changelog, Bug tracker&lt;br&gt;• Header giấy phép trong từng file&lt;br&gt;• Hạn: &lt;b&gt;17:00 CN 06/12/2026&lt;/b&gt; → olpvietnam@vaip.vn, thuky@vfossa.vn&lt;br&gt;• Chung kết &lt;b&gt;10/12&lt;/b&gt;: 15 phút trình bày + live demo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="380" y="1095" width="325" height="175" as="geometry"/></mxCell><mxCell id="p1_45" value="&lt;b&gt;CHẤM ĐIỂM 100&lt;/b&gt;&lt;br&gt;&lt;u&gt;PoF 50đ&lt;/u&gt;: Repo 5 · License 10 · Release 5 · Build 10 · Thư viện 10 · Tài liệu 10&lt;br&gt;&lt;u&gt;Sản phẩm 50đ&lt;/u&gt;: Nguyên gốc 10 · Hoàn thiện 10 · Thân thiện 10 · Bền vững 10 · Trình diễn &amp;amp; cộng đồng 10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="720" y="1095" width="320" height="175" as="geometry"/></mxCell><mxCell id="p1_46" value='&lt;b&gt;DIỄN GIẢI CỦA BTC (Telegram OLP)&lt;/b&gt;&lt;br&gt;"Nguyên lý thiết kế (Mục 4) chỉ mang tính định hướng. Giải pháp cụ thể do đội thi đề xuất để &lt;b&gt;xây dựng Tầng 1 cho bài toán minh họa ở Tầng 2&lt;/b&gt;. Bài toán Tầng 2 không cần phủ đủ 4 không gian, &lt;b&gt;chỉ cần 1 không gian&lt;/b&gt;."&lt;br&gt;&lt;br&gt;&lt;b&gt;⇒ Tối thiểu:&lt;/b&gt; Tầng 1 headless (4 dịch vụ ★) + 1 ứng dụng Tầng 2' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1070" y="1095" width="630" height="175" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. xT - kiến trúc v2.2"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="1460" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_1" value="&lt;b&gt;xT — Agent-native DX-OS · Kiến trúc v2.2&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;Bộ tool cố định · Nghiệp vụ là dữ liệu · Agent đề xuất, con người duyệt&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1660" height="50" as="geometry"/></mxCell><mxCell id="p2_2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1240" height="290" as="geometry"/></mxCell><mxCell id="p2_3" value="&lt;b&gt;TẦNG 2 — Desk + MCP Apps + 3 gói nghiệp vụ&lt;/b&gt; · [P] e-Office · [I] Quản trị agent" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="55" y="85" width="1200" height="30" as="geometry"/></mxCell><mxCell id="p2_4" value="&lt;b&gt;xT Desk · client chính&lt;/b&gt;&lt;br&gt;React/Vite + backend Python&lt;br&gt;Chat qwen3.5:4b local · proxy MCP&lt;br&gt;/desk/confirm/{id}: UI người (v0.1)&lt;br&gt;Chat + Desk đầy đủ: v0.3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="370" height="115" as="geometry"/></mxCell><mxCell id="p2_5" value="&lt;b&gt;MCP Apps · UI trong chat&lt;/b&gt;&lt;br&gt;AppRenderer · thẻ duyệt · orgchart&lt;br&gt;Form · Kanban + SLA · diff kế hoạch&lt;br&gt;Nút duyệt mở confirm_url&lt;br&gt;Gói JSON/YAML có phiên bản trong DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="465" y="125" width="370" height="115" as="geometry"/></mxCell><mxCell id="p2_6" value="&lt;b&gt;Ollama · profile full&lt;/b&gt;&lt;br&gt;qwen3.5:4b tự host&lt;br&gt;core-10 · num_ctx ≥ 16384&lt;br&gt;Ngoài Tầng 1; lõi không gọi LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="870" y="125" width="390" height="115" as="geometry"/></mxCell><mxCell id="p2_7" value="proxy LLM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p2_4" target="p2_6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_8" value="&lt;b&gt;Đề xuất–phê duyệt&lt;/b&gt;&lt;br&gt;Đơn đề nghị · người duyệt · SoD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="390" height="80" as="geometry"/></mxCell><mxCell id="p2_9" value="&lt;b&gt;Giao việc–SLA&lt;/b&gt;&lt;br&gt;Hộp việc · deadline · escalation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="465" y="270" width="390" height="80" as="geometry"/></mxCell><mxCell id="p2_10" value="&lt;b&gt;Nhân sự vòng đời&lt;/b&gt;&lt;br&gt;Onboarding → thay đổi → offboarding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="870" y="270" width="390" height="80" as="geometry"/></mxCell><mxCell id="p2_11" value="&lt;b&gt;CLIENT NGOÀI&lt;/b&gt; · MCP Streamable HTTP + OAuth" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="1240" height="25" as="geometry"/></mxCell><mxCell id="p2_12" value="&lt;b&gt;Claude Free&lt;/b&gt;&lt;br&gt;1 custom connector · cloud&lt;br&gt;Kết nối thật / Apps: chưa kiểm chứng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="390" height="85" as="geometry"/></mxCell><mxCell id="p2_13" value="&lt;b&gt;ChatGPT&lt;/b&gt;&lt;br&gt;Connector · cloud&lt;br&gt;Demo chỉ đọc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="465" y="430" width="390" height="85" as="geometry"/></mxCell><mxCell id="p2_14" value="&lt;b&gt;Goose CLI + Ollama&lt;/b&gt;&lt;br&gt;Client nguồn mở · local&lt;br&gt;Xác nhận qua Desk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="870" y="430" width="390" height="85" as="geometry"/></mxCell><mxCell id="p2_15" value="&lt;b&gt;Cloudflare Tunnel xt · profile public (demo)&lt;/b&gt;&lt;br&gt;xt.freepro.online → Desk + /desk/confirm/{id}&lt;br&gt;xt-mcp.freepro.online → /mcp · xt-api.freepro.online → /data, /workflow, /files, /rest&lt;br&gt;xt-auth.freepro.online → Keycloak · HTTPS, TLS kết thúc tại Cloudflare" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="555" width="1200" height="110" as="geometry"/></mxCell><mxCell id="p2_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p2_12" target="p2_15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p2_13" target="p2_15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p2_14" target="p2_15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_19" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1240" height="720" as="geometry"/></mxCell><mxCell id="p2_20" value="&lt;b&gt;TẦNG 1 — Lõi headless · Python · không UI nghiệp vụ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="55" y="705" width="1200" height="30" as="geometry"/></mxCell><mxCell id="p2_21" value="&lt;b&gt;★ Apache APISIX · 127.0.0.1:9080 · định tuyến theo Host&lt;/b&gt;&lt;br&gt;/auth · /data/v1 + /files/v1 · /workflow/v1 · /rest/v1 + /mcp&lt;br&gt;/mcp + PRM: passthrough, rate-limit IP; xt-api tự xác thực · các API dịch vụ khác: JWT&lt;br&gt;xt → Desk (Tầng 2) · xt-auth → Keycloak · xt-mcp → xt-api · xt-api → dịch vụ headless" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="755" width="1200" height="95" as="geometry"/></mxCell><mxCell id="p2_22" value="&lt;b&gt;★ Keycloak · SSO / MFA / DCR&lt;/b&gt;&lt;br&gt;Realm xt · Organization = tenant&lt;br&gt;OIDC / OAuth · PKCE S256&lt;br&gt;TOTP · xác thực tươi&lt;br&gt;Client người: xt-desk&lt;br&gt;xT giữ tổ chức / vai trò&lt;br&gt;Chặn admin UI từ ngoài" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="270" height="180" as="geometry"/></mxCell><mxCell id="p2_23" value="&lt;b&gt;xt-api · MCP server · 17 tool v0.1&lt;/b&gt;&lt;br&gt;Catalog cố định: ToolContract · không Code Mode&lt;br&gt;Streamable HTTP · 401 + PRM · REST/OpenAPI&lt;br&gt;JWT → tenant → IAM/SoD → autonomy → confirmation&lt;br&gt;CAS · idempotency · Poka-yoke · PII · audit&lt;br&gt;Model engine: spec → bảng thật + CHECK/FK + RLS&lt;br&gt;SpiffWorkflow: bước người in-process&lt;br&gt;/desk/confirm: Desk gọi API thực thi PendingOperation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="375" y="900" width="490" height="210" as="geometry"/></mxCell><mxCell id="p2_24" value="&lt;b&gt;★ xt-worker · Workflow&lt;/b&gt;&lt;br&gt;procrastinate + SpiffWorkflow&lt;br&gt;Timer / SLA · service task · outbox&lt;br&gt;Cùng image với xt-api&lt;br&gt;Job mang tenant_id; transaction/tenant&lt;br&gt;Retry · lease fencing · action allowlist&lt;br&gt;Kiểm lại quyền lúc thực thi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="900" width="350" height="180" as="geometry"/></mxCell><mxCell id="p2_25" value="&lt;b&gt;PostgREST · chỉ đọc&lt;/b&gt;&lt;br&gt;aud = xt-data · GET only&lt;br&gt;View api_t&amp;lt;seq&amp;gt;&lt;br&gt;Accept-Profile ràng tenant token&lt;br&gt;db-schemas động + NOTIFY&lt;br&gt;security_invoker=false&lt;br&gt;Loại field sensitive khỏi view" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="1160" width="270" height="190" as="geometry"/></mxCell><mxCell id="p2_26" value="&lt;b&gt;★ PostgreSQL 17 · schema-per-tenant&lt;/b&gt;&lt;br&gt;xt_t&amp;lt;seq&amp;gt;.&amp;lt;model&amp;gt; · tenant_id + RLS FORCE&lt;br&gt;xt_meta · xt_audit · jobs (procrastinate)&lt;br&gt;Mutation + audit + outbox + receipt: 1 transaction&lt;br&gt;Audit hash-chain theo tenant · append-only&lt;br&gt;Field sensitive: HMAC có khóa trong audit&lt;br&gt;Model apply 2 pha · rollout migration theo tenant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="375" y="1160" width="490" height="190" as="geometry"/></mxCell><mxCell id="p2_27" value="&lt;b&gt;★ SeaweedFS · object storage S3&lt;/b&gt;&lt;br&gt;Hồ sơ · hợp đồng · chứng từ&lt;br&gt;/files/v1 qua APISIX&lt;br&gt;Presigned upload qua gateway&lt;br&gt;Quarantine → ClamAV (full)&lt;br&gt;Không lộ UI master / filer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="1160" width="350" height="190" as="geometry"/></mxCell><mxCell id="p2_28" value="4 hostname → 1 gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_15" target="p2_21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_29" value="SSO / OAuth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_21" target="p2_22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_30" value="MCP / REST / workflow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_21" target="p2_23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_31" value="/data/v1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p2_21" target="p2_25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_32" value="transaction" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_23" target="p2_26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_33" value="jobs / BPMN state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_24" target="p2_26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_34" value="SELECT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_25" target="p2_26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_35" value="files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_23" target="p2_27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_36" value="&lt;b&gt;Compose:&lt;/b&gt; minimal / full / public · Docker Engine hoặc Podman · xT: Apache-2.0 · phụ thuộc OSI" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="1370" width="1200" height="30" as="geometry"/></mxCell><mxCell id="p2_37" value="&lt;b&gt;CHECKLIST ĐỀ THI · ÁNH XẠ KIẾN TRÚC&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Tầng 1 — 4 dịch vụ bắt buộc&lt;/b&gt;&lt;br&gt;☑ SSO → Keycloak&lt;br&gt;☑ API Gateway → APISIX&lt;br&gt;☑ Data → PostgreSQL + PostgREST&lt;br&gt;&amp;nbsp;&amp;nbsp; + SeaweedFS (phi cấu trúc)&lt;br&gt;☑ Workflow → SpiffWorkflow&lt;br&gt;&amp;nbsp;&amp;nbsp; trong xt-api + xt-worker&lt;br&gt;&lt;br&gt;&lt;b&gt;Tầng 2:&lt;/b&gt; Desk + MCP Apps + 3 gói&lt;br&gt;Ứng dụng có UI · lõi headless" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1310" y="80" width="390" height="290" as="geometry"/></mxCell><mxCell id="p2_38" value="&lt;b&gt;KÊNH XÁC NHẬN CỦA NGƯỜI&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. xt-api kiểm IAM/SoD trước xác nhận&lt;br&gt;2. Lưu PendingOperation (TTL 10 phút)&lt;br&gt;3. Trả confirmation_required + confirm_url&lt;br&gt;4. Người mở /desk/confirm/{id} ở Desk&lt;br&gt;5. Keycloak: max_age=0 + TOTP;&lt;br&gt;xác thực tươi trong 5 phút&lt;br&gt;6. Desk gọi xt-api kiểm lại và thực thi;&lt;br&gt;agent gọi lại cùng idempotency_key lấy receipt&lt;br&gt;&lt;br&gt;Tool không nhận tham số gate.&lt;br&gt;Không có kênh xác nhận CLI.&lt;br&gt;L3/vượt ngưỡng: prompt=login + acr.&lt;br&gt;Telegram nonce ký: kênh phụ (v0.2)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1310" y="390" width="390" height="360" as="geometry"/></mxCell><mxCell id="p2_39" value="&lt;b&gt;LÀN PII · THEO azp + POLICY TENANT&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Cloud:&lt;/b&gt; Claude / ChatGPT&lt;br&gt;PII luôn masked hoặc omitted&lt;br&gt;&lt;b&gt;Local:&lt;/b&gt; Desk / Goose + Ollama&lt;br&gt;Theo policy tenant: masked / local_only&lt;br&gt;&lt;b&gt;Human:&lt;/b&gt; phiên người ở Desk&lt;br&gt;Giá trị thật theo quyền&lt;br&gt;&lt;br&gt;Nhãn PII bắt buộc từ v0.1;&lt;br&gt;che output + audit egress từ v0.3.&lt;br&gt;Trước v0.3: full chỉ với dữ liệu demo,&lt;br&gt;không có PII thật.&lt;br&gt;Từ chối ghi ngược [PII:token] vào DB." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1310" y="770" width="390" height="310" as="geometry"/></mxCell><mxCell id="p2_40" value="&lt;b&gt;RANH GIỚI &amp;amp; NGUỒN THAM CHIẾU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bộ tool cố định; model/process là dữ liệu.&lt;br&gt;Agent đề xuất, người duyệt rồi mới áp dụng.&lt;br&gt;Desk / Goose dùng LLM local; lõi không gọi LLM.&lt;br&gt;&lt;br&gt;17 tool v0.1; 21 tool ở v1.0.&lt;br&gt;Đây là kiến trúc đích, không phải chứng nhận đã triển khai toàn bộ.&lt;br&gt;&lt;br&gt;docs/architecture-v2.md (v2.2)&lt;br&gt;docs/deployment-public.md&lt;br&gt;docs/tool-contracts-v1.md&lt;br&gt;CLAUDE.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1310" y="1100" width="390" height="320" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>