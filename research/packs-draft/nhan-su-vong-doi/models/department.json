      "required": true,
      "max": 120
    },
    {
      "id": "f3",
      "name": "head",
      "type": "user",
      "label": "Trưởng phòng"
    },
    {
      "id": "f4",
      "name": "active",
      "type": "bool",
      "label": "Đang hoạt động",
      "required": true,
      "default": true
    }
  ],
