  {
   "id": "universal.aggregate_state_json",
   "category": "aggregate",
   "title": "Đếm theo trạng thái; JSON vs oracle",
   "actor": "long",
   "skills": [
    "xt-core"
   ],
   "turns": [
    "Đếm số đề nghị tạm ứng theo từng trạng thái. Trả lời cuối cùng chỉ gồm một JSON dạng {\"draft\": số, \"in_review\": số, \"approved\": số, \"rejected\": số, \"paid\": số}."
   ],
   "expected": {
    "required": [
     {
      "tool": "aggregate_records",
      "args": {
       "model_id": "advance_request",
       "group_by": {
        "contains": "state"
       }
      }
     }
    ],
    "answer": [
     {
      "json": {
       "draft": {
        "oracle": "adv_by_state",
        "key": "draft"
       },
       "in_review": {
        "oracle": "adv_by_state",
        "key": "in_review"
       },
       "approved": {
        "oracle": "adv_by_state",
        "key": "approved"
       },
       "rejected": {
        "oracle": "adv_by_state",
        "key": "rejected"
       },
       "paid": {
        "oracle": "adv_by_state",
        "key": "paid"
       }
      }
     }
    ]
   }
  },
