      "default": "ca-nhan",
      "options": [{"value": "ca-nhan", "label": "Cá nhân"}, {"value": "doanh-nghiep", "label": "Doanh nghiệp"}]
    },
    {"id": "f4", "name": "phone", "type": "text", "label": "Điện thoại", "pii": "basic", "max": 30},
    {"id": "f5", "name": "email", "type": "text", "label": "Email", "pii": "basic", "max": 200},
    {
