# Mẫu cấu hình deploy. `make env` (hoặc provision.py) sao chép thành deploy/.env (không commit)
# và tự sinh giá trị cho mọi biến bí mật còn để trống (đánh dấu [tự sinh]).

# --- Hostname công khai (APISIX định tuyến theo Host) ---
XT_DOMAIN_DESK=xt.freepro.online
XT_DOMAIN_MCP=xt-mcp.freepro.online
XT_DOMAIN_API=xt-api.freepro.online
XT_DOMAIN_AUTH=xt-auth.freepro.online

# --- Cổng publish (chỉ bind 127.0.0.1) ---
APISIX_HTTP_PORT=9080
# Cổng Keycloak cho provision.py (Admin REST); không đi qua APISIX
KC_HTTP_PORT=18080

# --- Postgres ---
POSTGRES_USER=xt
POSTGRES_DB=xt
POSTGRES_PASSWORD=           # [tự sinh]

# --- Keycloak ---
XT_REALM=xt
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD= # [tự sinh]
KC_HEAP="-Xms128m -Xmx384m -XX:MaxMetaspaceSize=192m"

# --- Danh tính xT (docs/identity.md) ---
XT_IDP_INTROSPECTION=high_risk
XT_IDP_INTROSPECTION_CLIENT_ID=xt-api-introspect
XT_IDP_INTROSPECTION_CLIENT_SECRET= # [tự sinh]
# Client DCR của ChatGPT/Claude có client_id ngẫu nhiên: thêm vào đây sau khi đăng ký (identity.md, giới hạn hiện tại)
# Allowlist động cho connector DCR (docs/identity.md): xT tra Keycloak bằng service account view-clients
XT_MCP_CLIENT_REGISTRY=keycloak
XT_IDP_ADMIN_CLIENT_ID=xt-client-registry
XT_IDP_ADMIN_CLIENT_SECRET= # [tự sinh]
XT_MCP_CONNECTOR_REDIRECT_HOSTS=chatgpt.com,claude.ai,127.0.0.1
XT_MCP_ALLOWED_CLIENTS=xt-desk-agent
XT_MCP_HUMAN_CLIENTS=xt-desk
# Client của CHAT Desk (agent thay mặt người dùng): tier local, PII full. Desk dùng client này cho MCP, KHÔNG dùng xt-desk/xt-desk-confirm
XT_DESK_AGENT_CLIENT_ID=xt-desk-agent
XT_MCP_LOCAL_CLIENTS=xt-desk-agent
# Redirect cho dev Desk (vite) của client xt-desk-agent
XT_DESK_AGENT_DEV_REDIRECTS=http://localhost:5173/auth/callback,http://127.0.0.1:5173/auth/callback
XT_MCP_REQUIRED_SCOPES=mcp-xt
XT_MCP_SCOPES_SUPPORTED="mcp-xt openid profile email"
XT_CONFIRM_CLIENT_ID=xt-desk-confirm
XT_CONFIRM_ACR=urn:xt:acr:otp
XT_CONFIRM_REQUIRED_AMR=otp
# Phân cách dấu phẩy. 127.0.0.1 cho Claude Code (loopback http, khớp trusted-hosts + client policy); bỏ nếu không cần
XT_DCR_TRUSTED_HOSTS=chatgpt.com,claude.ai,127.0.0.1
# Role nghiệp vụ phải có TOTP (research/packs-draft/*/policies)
XT_TOTP_ROLES=dept_head,director,chief_accountant,payment_accountant,hr,hr_pii,it_admin,admin

# --- xT worker (xt worker) ---
XT_WORKER_HANDLERS=
# xt serve: module:factory trả ToolServices (bắt buộc cho xt-api thật)
XT_MCP_SERVICES=

# --- xT Desk (build arg của desk/Dockerfile; desk/.env.example giải thích từng biến) ---
DESK_LLM_URL=http://ollama:11434/v1
DESK_LLM_MODEL=qwen3.5:4b
DESK_LLM_REASONING_EFFORT=none
DESK_TOOL_PROFILE=core-10
DESK_MAX_STEPS=6
DESK_AUTH_MODE=oidc
# Sandbox MCP Apps phải KHÁC origin với Desk: dùng host xt-api (APISIX phục vụ /sandbox.html ở đó)
DESK_APP_CALLS_PER_SEC=5
DESK_APP_CALL_BURST=10
DESK_APP_MAX_INFLIGHT=4
DESK_APP_MAX_ARGS_BYTES=32768
DESK_APP_GLOBAL_CALLS_PER_SEC=10
DESK_APP_GLOBAL_BURST=20

# --- Profile full ---
OLLAMA_CONTEXT_LENGTH=16384
OPENBAO_DEV_TOKEN=           # [tự sinh] chỉ dùng cho OpenBao dev mode

# --- Profile public (Cloudflare Tunnel) ---
# Lấy từ ~/.config/xt/tunnel_token (docs/deployment-public.md). Không commit.
TUNNEL_TOKEN=
