{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xt.example/schemas/prompt.schema.json",
  "title": "xT MCP prompt definition",
  "description": "Provider-neutral prompt contract (modelled on REA promptContracts). Prompts guide the agent; they never add, remove or invoke tools. Steps are optional starting points. Loaded by xt.adapters.mcp via the contracts layer; every step tool must exist in the tool catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "title", "description", "since", "objective", "arguments", "steps", "discipline"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "minLength": 1, "maxLength": 400},
    "since": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "skills": {
      "type": "array",
      "items": {"type": "string", "pattern": "^xt-[a-z-]+$"},
      "description": "Skills that explain the details."
    },
    "objective": {"type": "string", "minLength": 1, "description": "What the agent should achieve. May reference arguments as {name}."},
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "required"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
          "description": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "completion": {
            "enum": ["model", "record", "request", "task", "person"],
            "description": "Session-aware completion source (tenant and permission scoped). A hint, never an authorization."
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tools", "instruction"],
        "properties": {
          "tools": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "inspect_workspace", "describe_model", "describe_process", "find_people",
                "search_records", "aggregate_records", "get_record", "get_inbox", "get_history",
                "create_record", "update_record", "transition_record", "upload_file",
                "submit_request", "decide_request", "create_task", "propose_model_change"
              ]
            }
          },
          "instruction": {"type": "string", "minLength": 1}
        }
      }
    },
    "discipline": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "description": "Rules rendered after the steps."
    }
  }
}
