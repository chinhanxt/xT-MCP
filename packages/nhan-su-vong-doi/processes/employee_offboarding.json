{
  "id": "employee_offboarding",
  "name": "Nghỉ việc (HR, Quản lý, IT, Kế toán, đóng hồ sơ)",
  "version": 1,
  "roles": ["hr", "it_admin", "payment_accountant", "chief_accountant", "dept_head", "director"],
  "steps": [
    {"id": "init", "type": "service", "name": "Sinh checklist nghỉ việc", "op": "create_lifecycle_tasks",
     "params": {"case_id": "case_id", "kind": "'offboarding'"}},
    {"id": "hr_confirm", "type": "approve", "name": "Nhân sự: xác nhận ngày nghỉ và đơn thôi việc", "role": "hr",
     "sla": {"after": "PT24H", "escalate_to": "director"}},
    {"id": "manager", "type": "approve", "name": "Quản lý: xác nhận bàn giao công việc, khách hàng, tài liệu", "role": "dept_head",
     "sla": {"after": "PT48H", "escalate_to": "director"}},
    {"id": "it", "type": "approve", "name": "IT: thu hồi toàn bộ quyền truy cập và thiết bị", "role": "it_admin",
     "sla": {"after": "PT4H", "escalate_to": "director"}},
    {"id": "chk_assets", "type": "service", "name": "Kiểm tra tài sản và quyền còn lại", "op": "check_unreturned_assets",
     "params": {"employee_id": "employee_id"}},
    {"id": "chk_overdue", "type": "service", "name": "Kiểm tra tạm ứng chưa hoàn", "op": "check_overdue_advances",
     "params": {"requester": "employee_user"}},
    {"id": "accounting", "type": "approve", "name": "Kế toán: quyết toán lương, phép, tạm ứng", "role": "payment_accountant",
     "sla": {"after": "PT24H", "escalate_to": "chief_accountant"}},
    {"id": "chief_acct_overdue", "type": "approve", "name": "Kế toán trưởng xử lý khoản còn nợ hoặc tài sản chưa trả", "role": "chief_accountant",
     "when": "chk_overdue_result['overdue'] > 0 or chk_assets_result['unreturned'] > 0"},
    {"id": "hr_close", "type": "approve", "name": "Nhân sự: ẩn danh dữ liệu theo thời hạn, đóng hồ sơ", "role": "hr",
     "sla": {"after": "PT24H", "escalate_to": "director"}},
    {"id": "close_case", "type": "service", "name": "Đóng hồ sơ nghỉ việc", "op": "close_lifecycle_case",
     "params": {"case_id": "case_id"}}
  ]
}
