# Cấu hình xT Desk. Sao chép thành .env. Thiếu biến BẮT BUỘC thì dev/build/preview báo lỗi rõ ràng.

# --- MCP (Streamable HTTP). Bắt buộc ---
DESK_MCP_URL=http://127.0.0.1:8000/mcp
# KHÔNG có bearer tĩnh ở bất kỳ đâu (cấu hình, proxy, gateway). Desk dùng token của chính người dùng (src/auth.ts).

# --- LLM (OpenAI-compatible chat completions). Bắt buộc ---
# Mặc định: ollama chạy trên máy. Ollama cần OLLAMA_CONTEXT_LENGTH >= 16384 (core-10 ~3.9k token tool).
DESK_LLM_URL=http://127.0.0.1:11434/v1
DESK_LLM_MODEL=qwen3.5:4b
# Ollama /v1 bỏ qua "think": false; phải dùng reasoning_effort. Để trống = không gửi.
DESK_LLM_REASONING_EFFORT=none

# --- Agent. Bắt buộc ---
# core-10 | all | danh sách tên tool phân tách bằng dấu phẩy
DESK_TOOL_PROFILE=core-10
DESK_MAX_STEPS=6

# --- Xác thực. Bắt buộc ---
# oidc = token người dùng từ Keycloak (chưa tích hợp: Desk FAIL CLOSED, không gọi MCP/LLM khi chưa đăng nhập)
# dev-unauthenticated = chỉ dev/e2e với server không đòi xác thực (hiện biểu ngữ cảnh báo)
DESK_AUTH_MODE=oidc

# --- xT ---
# Origin của xT Desk backend. confirm_url chỉ hợp lệ khi đúng origin này + /desk/confirm/{id}; ui/open-link tới origin này không cần hỏi.
DESK_XT_ORIGIN=https://xt.freepro.online

# --- Giới hạn lời gọi tool từ MCP App (mỗi instance App) ---
DESK_APP_CALLS_PER_SEC=5
DESK_APP_CALL_BURST=10
DESK_APP_MAX_INFLIGHT=4
# Trần kích thước `arguments` (JSON, byte) của mỗi tools/call từ App
DESK_APP_MAX_ARGS_BYTES=32768
# Rate limit CHUNG cho mỗi tool, cộng dồn mọi instance App
DESK_APP_GLOBAL_CALLS_PER_SEC=10
DESK_APP_GLOBAL_BURST=20

# --- Sandbox MCP Apps. Bắt buộc ---
# PHẢI khác origin với Desk (vd. Desk ở localhost:5173 thì sandbox ở 127.0.0.1:5173). Phục vụ /sandbox.html từ cùng bản build.
DESK_SANDBOX_URL=http://127.0.0.1:5173/sandbox.html

# --- Máy chủ dev/preview ---
DESK_HOST=localhost
DESK_PORT=5173
